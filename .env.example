# Copiar a .env antes del primer arranque. El .env real no se versiona.
DB_DATABASE=library
DB_USERNAME=library
DB_PASSWORD=cambiar-esta-clave

# Cadena larga aleatoria. Generar con:  openssl rand -base64 48
JWT_SECRET=

# Administrador inicial. Lo crea la API al arrancar, no la base.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Origen del frontend permitido por CORS y URL de la API que usa el frontend.
CORS_ORIGIN=http://localhost:5173
VITE_API_URL=http://localhost:8000/api/v1

# Permite al sembrador de tool registrar préstamos con fecha atrasada.
# Solo tiene efecto en local; dejar en false si no se va a sembrar.
DEMO_CLOCK=false
